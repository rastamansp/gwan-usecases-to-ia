{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest", "@cucumber/cucumber"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": [
    "**/*.ts",
    "**/*.feature"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
