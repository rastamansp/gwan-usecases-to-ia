# Configurações para Testes BDD
NODE_ENV=test

# Banco de Dados de Teste
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5432
TEST_DATABASE_USERNAME=postgres
TEST_DATABASE_PASSWORD=postgres
TEST_DATABASE_NAME=test_db

# RabbitMQ de Teste
TEST_RABBITMQ_HOST=localhost
TEST_RABBITMQ_PORT=5672
TEST_RABBITMQ_USERNAME=guest
TEST_RABBITMQ_PASSWORD=guest
TEST_RABBITMQ_VHOST=/

# Aplicação de Teste
TEST_APP_PORT=3001
TEST_APP_HOST=localhost

# Playwright para Testes
TEST_PLAYWRIGHT_HEADLESS=true
TEST_PLAYWRIGHT_SLOWMO=0
TEST_PLAYWRIGHT_TIMEOUT=30000

# Configurações de Teste
TEST_TIMEOUT=30000
TEST_RETRY_ATTEMPTS=3
TEST_RETRY_DELAY=1000

# Forçar uso de banco de teste
USE_TEST_DB=true

# Logs de Teste
TEST_LOG_LEVEL=info
TEST_LOG_FILE=test.log
