# Multi-stage build para produção - Versão com imagem base estável
FROM node:20-alpine AS builder

# Instalar pnpm globalmente
RUN npm install -g pnpm

# Criar diretório da aplicação
WORKDIR /app

# Copiar arquivos de dependências
COPY package.json pnpm-lock.yaml ./

# Instalar dependências
RUN pnpm install --frozen-lockfile

# Copiar código fonte
COPY . .

# Build da aplicação
RUN pnpm run build

# Stage de produção - usar imagem que já tem Chromium
FROM mcr.microsoft.com/playwright:v1.40.0-focal AS production

# Definir variáveis de ambiente
ENV NODE_ENV=production
ENV PORT=3000

# Criar usuário não-root
RUN groupadd -r nestjs && useradd -r -g nestjs nestjs

# Criar diretório da aplicação
WORKDIR /app

# Copiar código compilado do stage anterior
COPY --from=builder --chown=nestjs:nestjs /app/dist ./dist
COPY --from=builder --chown=nestjs:nestjs /app/node_modules ./node_modules

# Criar diretório para logs
RUN mkdir -p logs/screenshots && \
    chown -R nestjs:nestjs logs

# Mudar para usuário não-root
USER nestjs

# Expor porta
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Comando para produção
CMD ["node", "dist/main"]
