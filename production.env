# Configurações de Produção
NODE_ENV=production
PORT=3000
WORKER_PORT=3000
APP_NAME=Product Search Automation

# Banco de Dados - Produção
DATABASE_URL=postgresql://postgres:pazdedeus@postgres.gwan.com.br:5433/gwan_mart?sslmode=disable

# RabbitMQ - Produção
RABBITMQ_URL=amqp://root:pazdeDeus2025@rabbitmq.gwan.com.br:5672
RABBITMQ_QUEUE_SEARCH_PRODUCT=search-product

# Playwright - Produção
PLAYWRIGHT_BROWSER_PATH=/usr/bin/chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=60000

# Logging - Produção
LOG_LEVEL=info
LOG_FORMAT=json

# Segurança - Produção
CORS_ORIGIN=https://mart.gwan.com.br
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
