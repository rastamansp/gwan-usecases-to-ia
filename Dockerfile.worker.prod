# Multi-stage build para produção - Worker Versão Ultra Robusta
FROM node:20-alpine AS builder

# Instalar pnpm globalmente
RUN npm install -g pnpm

# Criar diretório da aplicação
WORKDIR /app

# Copiar arquivos de dependências
COPY package.json pnpm-lock.yaml ./

# Instalar dependências
RUN pnpm install --frozen-lockfile

# Copiar código fonte
COPY . .

# Build da aplicação
RUN pnpm run build

# Stage de produção
FROM node:20-alpine AS production

# Atualizar repositórios primeiro
RUN apk update

# Instalar dependências básicas primeiro
RUN apk add --no-cache \
    ca-certificates \
    nss

# Instalar dependências do Playwright uma por vez
RUN apk add --no-cache chromium || \
    apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/main chromium

RUN apk add --no-cache freetype || \
    apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/main freetype

RUN apk add --no-cache freetype-dev || \
    apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/main freetype-dev

RUN apk add --no-cache harfbuzz || \
    apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/main harfbuzz

RUN apk add --no-cache ttf-freefont || \
    apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/main ttf-freefont

# Limpar cache
RUN rm -rf /var/cache/apk/*

# Definir variáveis de ambiente para o Playwright
ENV PLAYWRIGHT_BROWSER_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV NODE_ENV=production

# Criar usuário não-root
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001

# Criar diretório da aplicação
WORKDIR /app

# Copiar código compilado do stage anterior
COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules

# Criar diretório para logs
RUN mkdir -p logs/screenshots && \
    chown -R nestjs:nodejs logs

# Mudar para usuário não-root
USER nestjs

# Expor porta
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/worker/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Comando para produção
CMD ["node", "dist/worker"]
